# docker compose auto-loads this file from the same directory as
# docker-compose.yml, regardless of whether compose was invoked from the
# VS Code Docker extension, a WSL terminal, or anywhere else. This is what
# removes the ambiguity behind the DISPLAY/config-path warning.

# WSLg's X server display. Confirm the actual value by opening a WSL
# terminal and running `echo $DISPLAY` -- it's usually :0, but don't assume.
# QT_AUTO_SCREEN_SCALE_FACTOR=2.5 #Intended to fix scaling issues, may not be working. 
DISPLAY=:0

# WSL-style path to your persistent config directory. Windows env vars like
# %APPDATA% do NOT exist inside a WSL/Linux shell -- this must be the
# WSL-mounted equivalent, e.g. /mnt/c/Users/<yourname>/AppData/Roaming/KICKRobot
# Find your Windows username by running `cmd.exe /c echo %USERNAME%` from WSL,
# or just check C:\Users\ in File Explorer.
KICKROBOT_CONFIG_DIR=/mnt/c/Users/tyler/AppData/Roaming/KICKRobot
